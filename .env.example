# Copy to .env and fill in. .env is gitignored; never commit real values.
# Locally the app reads this file; on AWS the same names come from Secrets Manager / the stack
# (deploy/aws/v2/template.yaml), and deploy/aws/v2/put_secrets.py copies the three API keys there.

# ---- Models (llm: in config.yaml; OpenAI is primary, Claude Sonnet the fallback) ----
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_WORKSPACE_ID=your-workspace-id

# ---- LangSmith tracing (off unless LANGSMITH_TRACING=true and a key is set) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=pharmassist-local
# full: traces carry question, answer and citations; metadata: v1 behaviour
LANGSMITH_CONTENT_MODE=full
# HMAC salt for the question id sent to LangSmith (any long random string); unset = no question id
TRACE_HASH_SALT=your-random-salt

# ---- PostgreSQL + pgvector (database: in config.yaml) ----
# docker-compose value below; on AWS composed at boot from the RDS endpoint and its managed secret
DATABASE_URL=postgresql://pharmassist:pharmassist@localhost:5432/pharmassist

# ---- Valkey: semantic cache, per-user limits, spend counters (cache: in config.yaml) ----
# ElastiCache has TLS on, so the hosted URL is rediss://; locally plain redis://
REDIS_URL=redis://localhost:6379/0

# ---- Auth (auth: in config.yaml): 256-bit random, e.g. `openssl rand -hex 32`; generated into Secrets Manager on AWS ----
# Docker: leave this commented out; the compose file supplies a local-only default.
# Running from source: uncomment and set a real value (the API refuses anything under 32 characters).
# JWT_SECRET=paste-64-hex-chars-here

# ---- Documents and uploads: S3 bucket (storage: in config.yaml) ----
PHARMASSIST_BUCKET=pharmassist-docs
# MinIO-compatible local store from docker-compose; unset on AWS
S3_ENDPOINT_URL=http://localhost:9000
# only when the API's S3 endpoint differs from the one a browser can reach (docker-compose: the API uses
# http://s3:9000, presigned citation links must say http://localhost:9000); unset on AWS and when both match
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# any value works for the local store/queue; real credentials come from the instance/task role on AWS
AWS_ACCESS_KEY_ID=pharmassist
AWS_SECRET_ACCESS_KEY=pharmassist-local
AWS_REGION=us-east-1

# ---- Ingestion queue (queue: in config.yaml): ElasticMQ locally, SQS on AWS ----
INGEST_QUEUE_URL=http://localhost:9324/000000000000/pharmassist-ingest
INGEST_DLQ_URL=http://localhost:9324/000000000000/pharmassist-ingest-dlq
# set for ElasticMQ; unset on AWS
SQS_ENDPOINT_URL=http://localhost:9324

# ---- Frontend dev server origin(s) allowed by the API (comma-separated); same-origin needs nothing ----
APP_CORS_ORIGINS=http://localhost:5173

# ---- Hosted only (set by the stack; leave unset locally) ----
# SSM_PARAMETER_PREFIX=/pharmassist/v2   # optional: SecureStrings under it become env vars (app/runtime_env.py)
