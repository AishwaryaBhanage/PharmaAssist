.env
.venv/
__pycache__/
*.pyc
.DS_Store
index/
*.egg-info/
.pytest_cache/
traces/
storage/
*.sqlite
*.sqlite-wal
*.sqlite-shm
# a trial eval run, kept out of the repo
reports/evals/baseline_2026-10-14_1607/


# the build artifacts the local one-command demo loads (scripts/seed_local.py): sections, chunks and
# their vectors, drug tables and figure crops; the other index/ and storage/ contents stay out
!index/
index/*
!index/docling_sections/
!index/tables/
!storage/
storage/*
!storage/figures/
storage/figures/e2e_*/
# regenerated by scripts/deepeval_score.py on every run; the comparison lives in EVALUATION.md
reports/deepeval/summary.md
reports/deepeval/per_question_golden.csv
# original screen recording stays local; the compressed MP4 is committed
writeup/demo/*.mov

# DeepEval runtime cache dirs (created by the library when scripts/deepeval_score.py runs)
.deepeval/
.deepeval_home/
